{
  "name": "orders-api",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm type-check && pnpm test"
  },
  "dependencies": {
    "express": "^4.21.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.10",
    "eslint": "^9.39.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.1.0"
  }
}
